---
import WaitlistButton from './waitlist-button.astro';
---

<section id="hero">
  <h1 class="headline">See what matters.<br />Ship without friction.</h1>
  <p class="subhead">
    Fast-moving product teams waste weeks building conflicting features, missing
    dependencies, and working on things that don't matter.
  </p>
  <p class="subhead">
    Sokkel connects your tools to catch misalignment before it costs you
    sprints, so engineers see how their work connects to company goals and
    adjust in real-time.
  </p>
  <WaitlistButton />
</section>

<style>
  #hero {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 8);
    align-items: center;
    text-align: center;

    .headline {
      margin: 0;
      font-weight: var(--font-weight-extrabold);
      line-height: 100%;
      font-size: var(--text-6xl-font-size);
      @media (min-width: 60rem) {
        font-size: var(--text-8xl-font-size);
      }

      color: transparent;
      background-image: url('/assets/flow-title.webp');
      background-repeat: no-repeat;
      background-size: calc(100% + 20px) calc(100% + 20px);
      background-position: -10px -10px;
      background-clip: text;

      @media (prefers-reduced-motion: reduce) {
        background-image: none;
        color: var(--color-text-primary);
      }
    }

    .subhead {
      max-width: 40ch;
      margin-block: 0;
      margin-inline: calc(var(--spacing) * 4);

      font-size: var(--text-lg-font-size);
      line-height: var(--text-lg-line-height);
      font-weight: var(--font-weight-medium);
      @media (min-width: 60rem) {
        font-size: var(--text-xl-font-size);
        line-height: var(--text-xl-line-height);
      }
    }
  }
</style>
